<RCC>
    <qresource prefix="/assets">
        <file alias="clinic-logo.png">assets/clinic-logo.png</file>
        <file alias="sidebar-care-illustration.png">assets/sidebar-care-illustration.png</file>
        <file alias="dashboard-care-illustration.png">assets/dashboard-care-illustration.png</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="dashboard.svg">icons/dashboard.svg</file>
        <file alias="patients.svg">icons/patients.svg</file>
        <file alias="appointments.svg">icons/appointments.svg</file>
        <file alias="queue.svg">icons/queue.svg</file>
        <file alias="search-sort.svg">icons/search-sort.svg</file>
        <file alias="reports.svg">icons/reports.svg</file>
        <file alias="chevron-down.svg">icons/chevron-down.svg</file>
        <file alias="chevron-up.svg">icons/chevron-up.svg</file>
    </qresource>
</RCC>
